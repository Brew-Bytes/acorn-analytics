{
  "name": "brew-bytes/acorn-analytics",
  "type": "package",
  "description": "Drop-in analytics provider integration for Roots Sage themes — GTM, GA4, and Plausible with environment gating, consent integration, and a unified custom-events API.",
  "keywords": [
    "wordpress",
    "sage",
    "acorn",
    "roots",
    "analytics",
    "ga4",
    "gtm",
    "plausible"
  ],
  "homepage": "https://github.com/Brew-Bytes/acorn-analytics",
  "license": "MIT",
  "authors": [
    {
      "name": "Scott Hartley",
      "homepage": "https://github.com/Brew-Bytes"
    }
  ],
  "support": {
    "issues": "https://github.com/Brew-Bytes/acorn-analytics/issues",
    "source": "https://github.com/Brew-Bytes/acorn-analytics"
  },
  "autoload": {
    "psr-4": {
      "BrewAndBytes\\AcornAnalytics\\": "src/"
    }
  },
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "laravel/pint": "^1.13",
    "php-stubs/wordpress-stubs": "^6.6",
    "phpstan/phpstan": "^2.1",
    "roots/acorn": "^4.0|^5.0",
    "szepeviktor/phpstan-wordpress": "^2.0"
  },
  "extra": {
    "acorn": {
      "providers": [
        "BrewAndBytes\\AcornAnalytics\\AnalyticsServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable"
}
